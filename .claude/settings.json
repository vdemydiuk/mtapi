{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_line_endings.py\" 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
