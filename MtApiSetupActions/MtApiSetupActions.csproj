<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- .NET Framework is present on every supported Windows, so the target machine needs no extra runtime -->
		<TargetFramework>net472</TargetFramework>
		<LangVersion>latest</LangVersion>
		<BaseOutputPath>$(SolutionDir)build\products</BaseOutputPath>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>
	<ItemGroup>
	  <PackageReference Include="WixToolset.Dtf.CustomAction" Version="5.0.0" />
	</ItemGroup>
	<!-- Dtf packs the custom action into obj\...\MtApiSetupActions.CA.dll but doesn't copy it to the output folder, where the installers look for it -->
	<Target Name="CopyCustomActionPackage" AfterTargets="PackCustomAction">
		<Copy SourceFiles="$(IntermediateOutputPath)$(TargetCAFileName)" DestinationFolder="$(OutDir)" />
	</Target>
</Project>